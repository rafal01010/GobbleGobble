# Copy to apps/backend/.env and fill each required selection explicitly.
# Process environment values override this file. Blank assignments are not setup.
# Mode is required from the load_settings caller, never from the environment.

# Location choices: google_grounding_lite, google_geocoding, geoapify.
# GG_LOCATION_PROVIDER=
# Discovery choices: google_grounding_lite, google_places, geoapify.
# GG_DISCOVERY_PROVIDER=
# Route choices: google_grounding_lite, google_routes, geoapify.
# GG_ROUTE_PROVIDER=
# Web choices: openai.
# GG_WEB_PROVIDER=

# Supply accessible owner and research model IDs.
# GG_OWNER_MODEL=
# GG_RESEARCH_MODEL=
# Required finite positive request timeouts, in seconds.
# GG_GEOGRAPHIC_TIMEOUT_SECONDS=
# GG_MODEL_TIMEOUT_SECONDS=

# Live mode requires OpenAI and credentials for each selected geographic service.
# Diagnostic and test modes relax credential presence only.
# OPENAI_API_KEY=
# GOOGLE_MAPS_API_KEY=
# GEOAPIFY_API_KEY=

# GG_REVIEW_PROVIDER=google_reviews
# GG_REVIEW_TIMEOUT_SECONDS=15

# Durable SQLite path. Defaults to data/runtime/gobblegobble.sqlite3 at repo root.
# Relative paths resolve from the repository root, independent of working directory.
# Blank values, colon syntax, memory databases, and URIs are rejected.
# GG_DATABASE_PATH=data/runtime/gobblegobble.sqlite3
